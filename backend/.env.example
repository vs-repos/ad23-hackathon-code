# Names only, no secrets. Copy these into your shell or platform config.
# This repository ships no `.env` and the app reads no `.env` file.
AGENDA_LLM_BASE_URL=
AGENDA_LLM_API_KEY=
AGENDA_LLM_MODEL=
# Demo-only keyless fallback: set to "on" to use a public no-auth endpoint when no key is set.
AGENDA_LLM_DEMO_FALLBACK=
